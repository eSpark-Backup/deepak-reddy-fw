{
    "write_flash_args" : [ "--flash_mode", "dio",
                           "--flash_size", "detect",
                           "--flash_freq", "40m" ],
    "flash_settings" : {
        "flash_mode": "dio",
        "flash_size": "detect",
        "flash_freq": "40m"
    },
    "flash_files" : {
        "0x10000" : "partition_table/partition-table.bin",
        "0x1000" : "bootloader/bootloader.bin",
        "0x30000" : "app-template.bin"
    },
    "partition_table" : { "offset" : "0x10000", "file" : "partition_table/partition-table.bin", "encrypted" : "true" },
    "bootloader" : { "offset" : "0x1000", "file" : "bootloader/bootloader.bin", "encrypted" : "true" },
    "app" : { "offset" : "0x30000", "file" : "app-template.bin", "encrypted" : "true" },
    "extra_esptool_args" : {
        "after"  : "no_reset",
        "before" : "default_reset",
        "stub"   : true,
        "chip"   : "esp32"
    }
}
